#include <iostream>
#include <vector>
#include <mutex>
#include <thread>
std::mutex cout_mutex;
void printToConsole(const std::string& str) {
	for (int i = 0;i < 10;i++) {
		if (cout_mutex.try_lock()){ std::cout << "Выполняется поток " << str << ", попытка " << i << "\n";
		cout_mutex.unlock();
		}
	}
}

int main() {
	system("chcp 1251");
	std::thread thread1(printToConsole, "A");
	std::thread thread2(printToConsole, "B");
	thread1.join();
	thread2.join();

}
