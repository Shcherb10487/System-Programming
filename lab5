std::mutex mutexx;
struct obj {
	std::string name;
	int value;
	std::string modifier;
	//obj(std::string name, int value, std::string mod) :name(name),value(value), modifier(mod) {}
	void fileOut(std::ofstream& out) {
		out << name << " " << value << " " << modifier << "\n";
	}
		
};
void copyPaste(std::string start, std::string result) {
	std::ifstream in;
	std::ofstream out;
	std::vector<std::string> str;
	std::string temp;
	in.open(start);
	if (in.is_open()) {
		while (std::getline(in, temp)) {
			str.emplace_back(temp);
		}
	}
	in.close();
	std::cout << "try to lock\n";
	mutexx.lock();
	std::cout << "lock success\n";
	out.open(result, std::ios::app | std::ios::ate);
	if (out.is_open()) for (auto i : str) out << i << std::endl;
	out.close();
	mutexx.unlock();
	str.clear();
}

void searchInVector(std::vector<obj>& output, std::string name, int start, int end) {
	for (int i = start;i < end;i++) {
		if (output.at(i).name == name) {
			mutexx.lock();
			std::ofstream out("name.txt", std::ios::app);
			if (out.is_open()) output.at(i).fileOut(out);
			out.close();
			mutexx.unlock();
		}
	}
}

void loadFromFile(std::vector<obj>& records){
	std::ifstream in("output.txt");
	records.reserve(40000000);
	obj r;
	std::string line;
	while (std::getline(in, line)) {
		const char* p = line.data();
		const char* end = p + line.size();

		const char* name_beg = p;
		while (p < end && *p != ' ') p++;
		const char* name_end = p;

		while (p < end && *p == ' ') p++;

		const char* valBeg = p;
		while (p < end && *p != ' ') p++;

		int value = 0.0;
		std::from_chars(valBeg, p, value);

		while (p < end && *p == ' ') p++;

		const char* mod_beg = p;
		const char* mod_end = end;
		while (mod_end > mod_beg && mod_end[-1] == '\n') mod_end--;

		r.name.assign(name_beg, name_end);
		r.value = value;
		r.modifier.assign(mod_beg, mod_end);
		records.push_back(std::move(r));
	}
}

void average(std::vector<obj>& output, std::vector<long>& nums, int dia_start, int dia_end) {
	long average = 0;
	for (int i = dia_start; i < dia_end;i++) {
		average += output.at(i).value;
	}
	nums.emplace_back(average/(dia_end - dia_start));
}
	
void moreThanAverage(std::vector<obj>& output, long average_num, int dia_start, int dia_end){
	for (int i = dia_start; i < dia_end;i++) {
		if (average_num < output.at(i).value) {
			mutexx.lock();
			std::ofstream out("more_than_avg.txt", std::ios::app);
			if (out.is_open()) output.at(i).fileOut(out);
			out.close();			
			mutexx.unlock();
		}
	}
}

