std::mutex mutexx;
void copypaste(std::string start, std::string result) {
	std::ifstream in;
	std::ofstream out;
	std::vector<std::string> str;
	std::string temp;
	in.open(start);
	if (in.is_open()) {
		while (std::getline(in, temp)) {
			str.emplace_back(temp);
		}
	}
	in.close();
	std::cout << "try to lock\n";
	mutexx.lock();
	std::cout << "lock success\n";
	out.open(result, std::ios::app | std::ios::ate);
	if (out.is_open()) for (auto i : str) out << i << std::endl;
	out.close();
	mutexx.unlock();
	str.clear();
}

void search_in_vector(std::vector<std::string>& output, std::string name, int start, int end) {
	std::vector <std::string>vect;
	for (int i = start;i < end;i++) {
		if (output.at(i).substr(0, name.length()) == name) vect.push_back(output.at(i));
	}

	mutexx.lock();
	std::ofstream out("name.txt", std::ios::app);
	if (out.is_open()) {
		for (std::string i : vect) {
			out << i << "\n";
		}
	}
	out.close();
	mutexx.unlock();
}

void average(std::vector<std::string> output, std::vector<int>& nums, int dia_start, int dia_end) {
	int average = 0;
	for (int i = dia_start; i < dia_end;i++) {
		int start = output.at(i).find(" ");
		int end = output.at(i).rfind(" ");
		average += std::stoi(output.at(i).substr(start, end - start));
	}
	nums.emplace_back(average/(dia_end - dia_start));
}

void more_Than_Average(std::vector<std::string> output, int average_num, int dia_start, int dia_end){
	for (int i = dia_start; i < dia_end;i++) {
		int start = output.at(i).find(" ");
		int end = output.at(i).rfind(" ");
		if (average_num < std::stoi(output.at(i).substr(start, end - start))) {
			mutexx.lock();
			std::ofstream out("more_than_avg.txt", std::ios::app);
			if (out.is_open()) out << output.at(i) << "\n";
			out.close();			
			mutexx.unlock();
		}
	}
}
