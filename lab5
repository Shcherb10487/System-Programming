std::mutex mutexx;
void copypaste(std::string start, std::string result) {
	std::ifstream in;
	std::ofstream out;
	std::vector<std::string> str;
	std::string temp;
	in.open(start);
	if (in.is_open()) {
		while (std::getline(in, temp)) {
			str.emplace_back(temp);
		}
		
	}
	in.close();

	mutexx.lock();
	out.open(result, std::ios::app | std::ios::ate);
	if (out.is_open()) for (auto i : str) out << i << std::endl;
	out.close();
	mutexx.unlock();
}

void search_in_vector(std::vector <std::string>& vect, std::string name, std::string infilename, std::string outfilename, int start, int end) {
	std::cout << "Search is started\n";
	std::string temp;
	mutexx.lock();
	std::ifstream in(infilename);
	if (in.is_open())
	{
		std::cout << "Cycle is started\n";
		for (int i = start; i < end; i++) {
			std::getline(in, temp);
			vect.emplace_back(temp);
			std::cout << vect.at(i) << "\n";
		}
	}
	else std::cout << "File doesent open!\n";
	in.close();
	mutexx.unlock();
		std::cout << "-------------";

	for (int i = start;i < end;i++) {
	if (vect.at(i).substr(0, name.length()) == name) {
		mutexx.lock();
		std::ofstream out(outfilename, std::ios::app);
		out << vect.at(i) << "\n";
		out.close();
		mutexx.unlock();
	}
	}
}
